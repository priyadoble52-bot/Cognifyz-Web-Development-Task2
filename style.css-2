
/* =========================================
   1. Reset & Global Styles
   ========================================= */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  line-height: 1.6;
  color: #333;
  background-color: #f8f9fa;
}

/* =========================================
   2. Desktop Navigation (Default: > 768px)
   ========================================= */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  background-color: #1a1a2e;
  position: sticky;
  top: 0;
  z-index: 1000;
}

.logo {
  color: #ffffff;
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.nav-links {
  display: flex;
  gap: 1.5rem;
}

.nav-links a {
  color: #e0e0e0;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s ease;
}

.nav-links a:hover {
  color: #4da8da;
}

/* Hide checkbox and hamburger icon on desktop */
.menu-checkbox,
.hamburger {
  display: none;
}

/* =========================================
   3. Content & Layout
   ========================================= */
.hero {
  text-align: center;
  padding: 4rem 1.5rem;
  background-color: #0f3460;
  color: #ffffff;
}

.hero h1 {
  font-size: 2.25rem;
  margin-bottom: 0.75rem;
}

.container {
  max-width: 1100px;
  margin: 3rem auto;
  padding: 0 1.5rem;
}

/* Desktop Grid: 3 columns */
.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.card {
  background: #ffffff;
  padding: 2rem;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
}

.card h2 {
  font-size: 1.25rem;
  margin-bottom: 0.75rem;
  color: #1a1a2e;
}

footer {
  text-align: center;
  padding: 2rem 1rem;
  background-color: #e9ecef;
  color: #6c757d;
  font-size: 0.875rem;
}

/* =========================================
   4. Media Queries & Responsive Design
   ========================================= */

/* Tablets (Max Width: 992px) */
@media (max-width: 992px) {
  .card-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile Screens (Max Width: 768px) */
@media (max-width: 768px) {
  
  /* Layout adjustments */
  .hero h1 {
    font-size: 1.75rem;
  }

  .card-grid {
    grid-template-columns: 1fr; /* Single column on mobile */
  }

  /* Show hamburger button */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 20px;
    cursor: pointer;
  }

  .hamburger .bar {
    display: block;
    height: 3px;
    width: 100%;
    background-color: #ffffff;
    border-radius: 3px;
    transition: all 0.3s ease;
  }

  /* Collapsible Navigation Menu */
  .nav-links {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: #1a1a2e;
    flex-direction: column;
    align-items: center;
    gap: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }

  .nav-links a {
    width: 100%;
    text-align: center;
    padding: 1rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* When checkbox is checked, slide down menu */
  .menu-checkbox:checked ~ .nav-links {
    max-height: 300px;
  }

  /* Hamburger icon animation to 'X' */
  .menu-checkbox:checked ~ .hamburger .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-checkbox:checked ~ .hamburger .bar:nth-child(2) {
    opacity: 0;
  }

  .menu-checkbox:checked ~ .hamburger .bar:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }
}
