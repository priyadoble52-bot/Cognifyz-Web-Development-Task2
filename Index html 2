<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- Viewport meta tag is essential for responsive design -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Responsive Design & Mobile Navigation</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Navigation Bar -->
  <header class="navbar">
    <div class="logo">DevBrand</div>

    <!-- Hidden checkbox to control toggle state -->
    <input type="checkbox" id="menu-toggle" class="menu-checkbox">
    
    <!-- Hamburger Icon Label -->
    <label for="menu-toggle" class="hamburger">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </label>

    <!-- Nav Links -->
    <nav class="nav-links">
      <a href="#home">Home</a>
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="hero" id="home">
    <h1>Clean, Modern & Responsive</h1>
    <p>Resize your browser or test on a mobile device to see the layout adapt seamlessly.</p>
  </section>

  <!-- Responsive Card Grid -->
  <main class="container" id="services">
    <section class="card-grid">
      <article class="card">
        <h2>Web Development</h2>
        <p>Building high-performance, accessible, and scalable web applications tailored to your needs.</p>
      </article>

      <article class="card">
        <h2>Responsive UI</h2>
        <p>Creating layouts that fluidly adjust across smartphones, tablets, laptops, and wide monitors.</p>
      </article>

      <article class="card">
        <h2>Performance</h2>
        <p>Optimizing asset delivery and code execution for lighting-fast load times on all network types.</p>
      </article>
    </section>
  </main>

  <footer>
    <p>&copy; 2026 DevBrand. All rights reserved.</p>
  </footer>

</body>
</html>
